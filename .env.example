# MLGuard Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
DASHBOARD_PORT=8501

# Storage Paths
DATA_STORAGE_DIR=./data/uploads
MODEL_STORAGE_DIR=./artifacts/models
REFERENCE_DATA_DIR=./artifacts/reference
DATABASE_URL=sqlite:///./mlguard.db

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=MLGuard_Experiments

# Monitoring Configuration
DRIFT_P_VALUE_THRESHOLD=0.05
LATENCY_ALERT_THRESHOLD_MS=250.0
ERROR_RATE_ALERT_THRESHOLD=0.10
MIN_DRIFT_SAMPLE_SIZE=20

# API Settings
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
